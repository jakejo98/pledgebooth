rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /user_account_list/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.status == '미인증';

      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['coupleNames', 'weddingDate', 'updatedAt']);

      allow delete: if false;
    }

    // 계정 찾기용: 문서 ID(이름+연락처 해시)를 알아야만 단건 조회 가능, 목록 조회 불가
    match /find_user_account/{key} {
      allow get: if true;

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'email']);

      // 이전 형식(maskedEmail) 문서를 본인이 로그인할 때 새 형식으로 교체
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'email']);

      allow list, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
